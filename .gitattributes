# Normalize line endings: LF in the repository and in checkouts.
* text=auto eol=lf

# Rust sources are always LF.
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.lock text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries.
*.png binary
*.jpg binary
*.ico binary
